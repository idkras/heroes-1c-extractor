# ✅ ОБЯЗАТЕЛЬНО: Специальный анализ ошибок
def analyze_errors_first(data):
    errors = []
    exceptions = []
    
    for item in data:
        try:
            process_item(item)
        except Exception as e:
            errors.append(e)
            exceptions.append(item)
    
    # Ошибки - это важная информация!
    return analyze_error_patterns(errors, exceptions)
```

